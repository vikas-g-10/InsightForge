# InsightForge Frontend Environment Configuration
# If left blank, Vite proxy forwards /api and /health to http://127.0.0.1:8000 in dev.
# For cross-origin backend deployments, specify the backend URL:
# VITE_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=

# Supabase Auth & Storage Configuration
# Find these in your Supabase project dashboard -> Settings -> API
# VITE_SUPABASE_URL: Your Supabase project URL (e.g., https://xyzcompany.supabase.co)
# VITE_SUPABASE_ANON_KEY: Your project public anon key (safe for browser client)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
