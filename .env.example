# Copy to .env (never commit .env). Placeholders only.
# Load with: cd backend && uvicorn main:app --reload --env-file ../.env

# "lite" (default, hosted) or "full" (local only; no extra behavior yet)
APP_MODE=lite

# Comma-separated explicit frontend origins. No wildcards, no paths.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limits for POST /api/ingest/validate (positive integers).
MAX_UPLOAD_BYTES=52428800
MAX_ROWS=2000

# Image Defect Vision (Ollama inference provider)
# For local dev: http://localhost:11434 (start via: ollama serve; ollama pull gemma3:4b)
# For cloud deployment: Point to a secure, private remote inference instance (localhost will not resolve)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=30.0
MAX_IMAGE_UPLOAD_BYTES=10485760

# Supabase Authentication & Token Verification (Server Configuration)
# SUPABASE_URL: Project URL used to fetch JWKS keys from ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_JWT_SECRET: Optional server-only secret for legacy HS256 symmetric signing (NEVER expose to frontend)
SUPABASE_JWT_SECRET=
# Expected audience in JWT claims (defaults to "authenticated")
SUPABASE_JWT_AUDIENCE=authenticated
# Enforce authentication on all protected API routes (defaults to true)
AUTH_ENABLED=true

# Frontend Configuration (for reference when creating frontend/.env.local)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
